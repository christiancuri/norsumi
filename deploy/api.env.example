# Production API config. Copy to /opt/norsumi/api.env on the VPS, fill every
# empty value, chmod 600. Never commit real values.
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://norsumi.com
CORS_ORIGIN=https://norsumi.com
REGISTRATION_OPEN=true
# Behind the stack's Caddy, which overwrites X-Forwarded-For with the real
# client IP (from Cf-Connecting-Ip). The API trusts exactly one hop.
TRUST_PROXY=true

# MongoDB Atlas (allow the VPS public IP in Atlas > Network Access)
MONGODB_URI=
MONGODB_DB=norsumi

# openssl rand -hex 32 for each. Rotating JWT_SECRET logs everyone out;
# rotating ARGON2_PEPPER invalidates every stored password hash.
JWT_SECRET=
ARGON2_PEPPER=
MEDIA_SIGNING_SECRET=
# openssl rand -base64 32. Wraps every user's data key: losing or rotating it
# makes all stored items unreadable. Back it up outside the VPS.
MASTER_KEY=

# Google sign-in: OAuth client ids, comma-separated, web client first.
# Empty disables Google sign-in.
GOOGLE_CLIENT_IDS=

# Backblaze B2 (S3-compatible), e.g. https://s3.us-west-004.backblazeb2.com
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OpenRouter
OPENROUTER_API_KEY=
# Any OpenRouter model ids (https://openrouter.ai/models). The app enforces
# Zero Data Retention, so pick models that have a ZDR endpoint.
# Vision model for screenshots/images: needs image input + structured outputs.
AI_VISION_MODEL=
AI_VISION_FALLBACK_MODEL=
# Text model for links and notes: needs structured outputs.
AI_TEXT_MODEL=
AI_TEXT_FALLBACK_MODEL=
# Embedding model for semantic search.
AI_EMBEDDING_MODEL=

WORKER_CONCURRENCY=3
# Items each user may send to the AI per UTC day (creates + reprocesses).
AI_DAILY_ITEM_LIMIT=500
