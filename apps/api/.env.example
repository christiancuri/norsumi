# norsumi API configuration. Copy to .env and fill in.
# Generate secrets with: openssl rand -base64 48

# --- Server ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Public origin clients reach the API at. Signed media URLs are built on it.
PUBLIC_URL=http://localhost:3000
# Comma-separated browser origins allowed by CORS, or "*". Requests without
# an Origin header (mobile apps) are always allowed.
CORS_ORIGIN=http://localhost:5173
# "false" disables POST /api/auth/register (and Google sign-up of new users).
REGISTRATION_OPEN=true
# "true" only behind exactly one reverse proxy on a private network that
# REPLACES X-Forwarded-For with the real client IP (see deploy/Caddyfile).
TRUST_PROXY=false
# Parallel AI jobs in this process. 0 disables the in-process worker.
WORKER_CONCURRENCY=3
# Items each user may send to the AI per UTC day (creates + reprocesses).
AI_DAILY_ITEM_LIMIT=500

# --- MongoDB --------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=norsumi

# --- Secrets --------------------------------------------------------------
# Signs access tokens (HS256). At least 32 characters.
JWT_SECRET=change-me-at-least-32-random-characters
# Signs media URLs (HMAC-SHA256). At least 32 characters.
MEDIA_SIGNING_SECRET=change-me-at-least-32-random-characters
# argon2id pepper (never stored in the DB). At least 32 characters. Changing
# it invalidates every password: rotate only with a new hash version.
ARGON2_PEPPER=change-me-at-least-32-random-characters
# 32 random bytes, base64 (openssl rand -base64 32). Wraps every user's data
# key. Losing it makes every stored blob unreadable. Back it up.
MASTER_KEY=

# --- Google sign-in (optional) ------------------------------------------
# OAuth client ids accepted as ID-token audience, comma-separated.
# The FIRST one must be the web client (it is exposed in /api/info for
# Google Identity Services); add the Android client id after it.
# Leave empty to disable Google sign-in.
GOOGLE_CLIENT_IDS=

# --- Object storage (S3-compatible: Backblaze B2, R2, MinIO, S3...) -------
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=norsumi
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI (OpenRouter, Zero Data Retention enforced on every call) ----------
OPENROUTER_API_KEY=
# Each call tries the primary model, then once the fallback (with its own
# per-vendor parameters) if the primary errors or returns unusable JSON.
# Vision model for screenshots/images.
# Any OpenRouter model ids (https://openrouter.ai/models). The app enforces
# Zero Data Retention, so pick models that have a ZDR endpoint.
# Vision model for screenshots/images: needs image input + structured outputs.
AI_VISION_MODEL=
AI_VISION_FALLBACK_MODEL=
# Text model for links and notes: needs structured outputs.
AI_TEXT_MODEL=
AI_TEXT_FALLBACK_MODEL=
# Embedding model for semantic search.
AI_EMBEDDING_MODEL=
